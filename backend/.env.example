# Copie este archivo como .env y reemplace los valores. Nunca versione .env.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:CAMBIAR@localhost:5432/nexobd
# Genere uno con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=CAMBIAR_POR_UN_SECRETO_ALEATORIO_DE_AL_MENOS_32_CARACTERES
FRONTEND_ORIGIN=http://localhost:4200
# Número de proxies inversos de confianza (0 en desarrollo local)
TRUST_PROXY=0
